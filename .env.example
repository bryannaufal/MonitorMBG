# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Manual local backend from host/WSL:
DATABASE_URL=postgresql+asyncpg://monitor_mbg:monitor_mbg_secret@localhost:5432/monitor_mbg
# Docker compose overrides backend DATABASE_URL to use host "postgres".
POSTGRES_USER=monitor_mbg
POSTGRES_PASSWORD=monitor_mbg_secret
POSTGRES_DB=monitor_mbg

# ──────────────────────────────────────────────
# Redis (Message Broker)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ──────────────────────────────────────────────
# AI / ML API Keys
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
HUGGINGFACE_TOKEN=hf_your-huggingface-token

# ──────────────────────────────────────────────
# Kimi — penilaian risiko (DAMPAK, DAPAT DITINDAK) + GIZI (vision)
# ──────────────────────────────────────────────
# Kosong = fallback rules-only (tanpa LLM).
#
# PENTING: key dan base URL harus MATCH. Salah endpoint → HTTP 401.
#
# ── Opsi A: Kimi Code Plan (key sk-kimi-... dari kimi.com/code) ──
#   Billing: langganan flat (termasuk vision di model yang sama).
#   Base URL: https://api.kimi.com/coding/v1
#   KIMI_MODEL / KIMI_VISION_MODEL: kimi-k2-turbo-preview atau kimi-for-coding
#
# ── Opsi B: Moonshot Developer (key dari platform.kimi.ai) ──
#   Billing: pay-per-token.
#   Base URL: https://api.moonshot.ai/v1
#   KIMI_MODEL: kimi-k2.6 (teks) atau kimi-k2-turbo-preview
#   KIMI_VISION_MODEL: moonshot-v1-8k-vision-preview  ← termurah untuk 1 foto
#     alternatif: moonshot-v1-32k-vision-preview | kimi-k2.6 (multimodal, lebih mahal)
#
# GIZI (nutrition_scorer):
#   SCRAPER_MODE=fixture → rules dari deskripsi (tanpa API vision)
#   SCRAPER_MODE=live    → Kimi vision bila ada lampiran + KIMI_API_KEY
#   Tanpa foto → GIZI = — (belum dinilai)
#
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k2-turbo-preview
KIMI_VISION_MODEL=kimi-k2-turbo-preview
KIMI_TIMEOUT_SECONDS=60

# Copilot RAG — embedding Google Gemini (768 dim) + fallback lokal jika GEMINI_API_KEY kosong
# Tanpa key: local-fixture-v1 (256 dim, hash deterministik). Chat sintesis tetap pakai KIMI_API_KEY.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
COPILOT_TOP_K=5

# ──────────────────────────────────────────────
# Intake / Scraper
# ──────────────────────────────────────────────
# fixture = data demo JSON — penilaian rules/seed saja, TANPA panggilan LLM
# live    = fetch eksternal + Kimi scoring bila KIMI_API_KEY ada
# SCRAPER_MODE=fixture
SCRAPER_MODE=live

# Provider saat SCRAPER_MODE=live (diabaikan jika SCRAPER_MODE=fixture):
# twitter | rss | twitter,rss | rss,twitter | both
SCRAPER_LIVE_PROVIDER=twitter

# true  = setelah scrape: Kimi scoring + cek threshold → auto Kasus/Tiket jika lolos
# false = scrape hanya append ke Kotak Masuk (lebih cepat; tinjau manual)
AUTO_TICKET_ON_INTAKE=false

SCRAPER_KEYWORDS=mbg,makan bergizi,belatung,keracunan,gizi

# ── twitterapi.io (https://twitterapi.io) ──
# API key dari dashboard → header X-API-Key
# JANGAN commit .env — simpan key hanya di .env lokal
TWITTERAPI_IO_API_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io
# Query pakai operator X advanced search (sama seperti di x.com/search-advanced)
TWITTERAPI_IO_SEARCH_QUERY=(MBG OR "makan bergizi") lang:id -filter:replies
TWITTERAPI_IO_QUERY_TYPE=Latest
SCRAPER_TWITTER_MAX_RESULTS=10

# ── Fallback RSS (SCRAPER_LIVE_PROVIDER=rss) ──
SCRAPER_RSS_URL=https://news.google.com/rss/search?q=MBG+makan+bergizi+indonesia&hl=id&gl=ID&ceid=ID:id

# ──────────────────────────────────────────────
# Frontend (Next.js public vars must start with NEXT_PUBLIC_)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
